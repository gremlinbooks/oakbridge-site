# Resend (contact form email delivery)
RESEND_API_KEY=

# Email addresses used by the contact API route
CONTACT_TO_EMAIL=info@oakbridgelabs.com
CONTACT_FROM_EMAIL=Oakbridge Labs <onboarding@resend.dev>

# Optional: Plausible domain (only needed if using Plausible instead of Vercel Analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=oakbridgelabs.com
